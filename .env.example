# --- Supabase ---
# URL del proyecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave publica (anon) usada en el cliente / navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio (service_role) - SOLO backend, nunca exponer al cliente.
# Se usa en las API routes para operaciones privilegiadas (descarga de storage,
# escritura de resultados de OCR, bypass de RLS controlado).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nombre del bucket de Storage donde se guardan los documentos originales
SUPABASE_STORAGE_BUCKET=invoices

# --- App ---
# Umbral (0-100) de confianza por debajo del cual una factura se marca
# automaticamente como "needs_review" para validacion humana.
OCR_CONFIDENCE_THRESHOLD=70
